# ============================================
# Flask Configuration
# ============================================
FLASK_APP=app.py
FLASK_ENV=development          # Options: development, production
FLASK_DEBUG=1                  # Set to 0 in production

# ============================================
# Security Keys (CHANGE THESE IN PRODUCTION!)
# ============================================
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# ============================================
# Database Configuration (MySQL)
# ============================================
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
# Example: mysql+pymysql://root:password@localhost:3306/attendance_db
#
# For local development with SQLite (no MySQL needed):
# SQLALCHEMY_DATABASE_URI=sqlite:///project.db
SQLALCHEMY_DATABASE_URI=mysql+pymysql://root:your_password@localhost:3306/attendance_db

# ============================================
# Uploads Configuration
# ============================================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216    # 16 MB max upload size (in bytes)
